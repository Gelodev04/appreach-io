generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

type EmailAccountsAdsPower {
  groupId   String?
  groupName String?
  ip        String?
  ipCountry String?
  profileId String
  proxyId   Int?
  status    String
}

type EmailAccountsEmailReporting {
  inboxReset          Boolean
  lastCollectionSaved String
  lastSavedEmail      String   @db.ObjectId
  lastSuccess         DateTime @db.Date
}

type EmailAccountsEngagementAccount {
  active      Boolean
  receiverLog EmailAccountsEngagementAccountReceiverLog[]
  via         String
}

type EmailAccountsEngagementAccountReceiverLog {
  hostId      String?  @db.ObjectId
  lastSuccess DateTime @db.Date
  sentFrom    String
}

type EmailAccountsInboxEngagement {
  active Boolean
}

type EmailAccountsInboxPlacement {
  active Boolean
}

type EmailAccountsPlacementAccount {
  active      Boolean
  receiverLog EmailAccountsPlacementAccountReceiverLog[]
}

type EmailAccountsPlacementAccountReceiverLog {
  lastSuccess DateTime @db.Date
  sentFrom    String
}

type EmailAccountsRelayAccount {
  active Boolean
}

type EmailAccountsTestResults {
  imap        Boolean
  lastUpdated DateTime @db.Date
  smtp        Boolean
}

type EmailAccountsVpsDetails {
  machineId   String
  machineName String
}

type EmailAccountsWebMail {
  faSecret       String                     @map("2faSecret")
  appPassword    String?
  error          EmailAccountsWebMailError?
  errorValue     String?
  lastOpened     DateTime?                  @db.Date
  lastSuccess    DateTime?                  @db.Date
  password       String
  qualityControl String?
  recoveryEmail  String
  recoveryEmail2 String
  remarks        String?
  routine        String
  status         String
}

type EmailAccountsWebMailError {
  /// Could not determine type: the field only had null or empty values in the sample set.
  comment    Json?
  count      Int?
  message    String
  screenshot String?
  timestamp  DateTime @db.Date
  traceback  String
  value      String?
}

type EmailValidatorDownload {
  catch_all     Int
  csvDownload   String?
  disposable    Int
  invalid       Int
  ok            Int
  unique_emails Int
  unknown       Int
  unverified    Int
  verified      Int
}

type EmailValidatorMillionverifier {
  catch_all          Int
  createdate         String
  credit             Int
  disposable         Int
  error              String
  estimated_time_sec Int
  file_id            String
  file_name          String
  invalid            Int
  ok                 Int
  percent            Int
  reverify           Int
  status             String
  total_rows         Int
  unique_emails      Int
  unknown            Int
  unverified         Int
  updated_at         String
  verified           Int
}

type EmailValidatorUpload {
  csvUpload    String
  dateUploaded DateTime? @default(now())
  listName     String
}

type AttributeUploadsEntityResults {
  matched Int @default(0)
  created Int @default(0)
  updated Int @default(0)
}

type AttributeUploadsProcessingResults {
  persons        AttributeUploadsEntityResults?
  companies      AttributeUploadsEntityResults?
  custom         AttributeUploadsEntityResults?
  errors         Int                            @default(0)
  columnsSkipped String?
  columnsMapped  String?
  rowErrors      String[]
}

type AttributeUploadsMetadata {
  processing_status  String
  updated_at         DateTime?                          @db.Date
  processing_results AttributeUploadsProcessingResults?
}

type HostsLookerStudio {
  embedUrl        String
  hasToRegenerate Boolean?
}

type HostsNotifications {
  emailAddressArray String[]
  slackChannel      String?
}

type HostsUserSettings {
  autoExcludeAddresses      String[]
  autoExcludeDomains        String[]
  autoExcludeUsernames      String[]
  ccAddressArray            String[]
  ccAddressString           String?
  ccMessage                 String?
  ccName                    String?
  /// Could not determine type: the field only had null or empty values in the sample set.
  doNotContactAddresses     Json?
  /// Could not determine type: the field only had null or empty values in the sample set.
  doNotContactDomains       Json?
  doNotContactGoogleSheet   String?
  externalSenderAddresses   String[]
  hasCustomMessage          Boolean?
  leadCategories            HostsUserSettingsLeadCategories[]
  notificationAddressArray  String[]
  notificationAddressString String?
  pronoun1                  String?
  pronoun2                  String?
  timezone                  String
  warmupTags                String[]
}

type HostsUserSettingsLeadCategories {
  name             String
  sendNotification String
}

type HostsEngagementSettings {
  scrollMessage   Int
  markImportant   Int
  removeSpam      Int
  movePrimary     Int
  clickLink       Int
  replyMessage    Int
  linksToClick    String[] @default([])
  linksNotToClick String[] @default([])
  filterId        String?
  disableFilterId Boolean?
  replyPrompt     String
}

type SeedBatchesGenerate {
  clickLink       Boolean?
  downloadMessage Boolean?
  esps            SeedBatchesGenerateEsps?
  markImportant   Boolean?
  movePrimary     Boolean?
  prioritizeToken Boolean?
  removeSpam      Boolean?
  replyMessage    Boolean?
  scrollMessage   Boolean?
  total           Int
  type            String
}

type SeedBatchesGenerateEsps {
  googleBusiness    Int?
  googlePersonal    Int?
  microsoftBusiness Int?
  microsoftPersonal Int?
}

type SeedBatchesResults {
  csvUrl       String
  errorDetails String?
  esps         SeedBatchesResultsEsps?
  total        Int
}

type SeedBatchesResultsEsps {
  googleBusiness    Int?
  googlePersonal    Int?
  microsoftBusiness Int?
  microsoftPersonal Int?
}

type UserSettingsAppLogin {
  adminView    Boolean?
  approved     Boolean?
  companyName  String?
  /// Multiple data types found: String: 25%, DateTime (Date): 75% out of 60 sampled entries
  currentLogin DateTime? @db.Date
  firstName    String?
  /// Multiple data types found: String: 29.4%, DateTime (Date): 70.6% out of 60 sampled entries
  lastLogin    DateTime? @db.Date
  lastName     String?
  password     String?
  phone        String?
  username     String
  verified     Boolean?
  view         String?
}

type UserSettingsApproval {
  lastSent        DateTime? @db.Date
  token           String?
  tokenExpiration DateTime? @db.Date
  verifiedOn      DateTime? @db.Date
}

type UserSettingsLookerStudio {
  embedUrl        String
  hasToRegenerate Boolean?
}

type UserSettingsPlan {
  amount              Int?
  amount_decimal      String?
  checkout_session_id String?
  current_period_end  DateTime? @db.Date
  lookup_key          String?
  price_id            String?
  start_date          DateTime? @db.Date
  status              String?
  subscription_id     String?
  trial_end           DateTime? @db.Date
  customPlan          Boolean?
}

type UserSettingsResetPassword {
  /// Multiple data types found: String: 42.9%, DateTime (Date): 57.1% out of 60 sampled entries
  lastReset       Json?
  token           String?
  tokenExpiration DateTime? @db.Date
}

type UserSettingsSeeds {
  assignedCount Int?
}

type UserSettingsSenders {
  /// Multiple data types found: Int: 96.5%, BigInt: 3.5% out of 57 sampled entries
  assignedCount Int
  /// Multiple data types found: Int: 96.5%, BigInt: 3.5% out of 57 sampled entries
  usedCount     Int
}

type UserSettingsStripe {
  amount         Int
  amount_decimal String
  id             String
  start_date     String
  status         String
}

type UserSettingsTrackingMarketing {
  callRequested     Boolean?
  emailsSendsPerDay String?
  hearAboutUs       String?
  ipAddress         String?
}

type UserSettingsVerification {
  /// Multiple data types found: String: 24.6%, DateTime (Date): 75.4% out of 60 sampled entries
  lastSent        Json?
  token           String?
  tokenExpiration DateTime? @db.Date
  /// Multiple data types found: String: 16.3%, DateTime (Date): 83.7% out of 60 sampled entries
  verifiedOn      Json?
}

type WebMailBigquery {
  status String
}

type WebMailEmail {
  messageId  String?
  rawMessage String
}

type WebMailHost {
  hostCrypt String
  hostId    String @db.ObjectId
}

type WebMailInboxEngagement {
  clickLink       Boolean
  downloadMessage Boolean?
  lastUpdated     DateTime @db.Date
  markImportant   Boolean?
  movePrimary     Boolean?
  removeSpam      Boolean?
  scrollMessage   Boolean?
}

type WebMailSummary {
  accountOwner String
  downloadDate DateTime @db.Date
  emailDate    DateTime @db.Date
  espCamelCase String
  folder       String
  fromEmail    String
  fromHeadline String?
  fromName     String
  fromString   String?
  mailedBy     String?
  security     String?
  server       String
  signedBy     String?
  subject      String
  toEmail      String
  toString     String
  type         String
}

type UserSettingsPlanPermissions {
  seeds             Int @default(0)
  senderProfiles    Int @default(0)
  senderAddresses   Int @default(0)
  verifyCredits     Int @default(0)
  attributeCredits  Int @default(0)
  smartLeadAccounts Int @default(0)
}

type UserSettingsPlanPermissionFeatures {
  engagementMax Int     @default(0)
  scrollMessage Boolean
  markImportant Boolean
  removeSpam    Boolean
  movePrimary   Boolean
  clickLink     Boolean
  replyMessage  Boolean
}

type UserSettingsWebhook {
  token String?
}

type EngagementFeatures {
  scrollMessage Boolean
  markImportant Boolean
  removeSpam    Boolean
  movePrimary   Boolean
  clickLink     Boolean
  replyMessage  Boolean
}

type SmartLead {
  client_id Int?
  type      String
}

type SenderAccountsMetadata {
  created_at           DateTime? @db.Date
  updated_at           DateTime  @db.Date
  bigquery_sync_status String?
}

type EventContent {
  body String?
}

type EventLeadStatus {
  name      String?
  sentiment String?
}

type EventMetadata {
  bigquery_sync_status String
  created_at           DateTime @db.Date
  updated_at           DateTime @db.Date
}

type EventRecipient {
  email        String?
  linkedin_url String?
}

type EventSender {
  linkedin_profile String?
  email            String?
}

type EventUpdateHistory {
  source     String
  host_id    String?  @db.ObjectId
  updated_at DateTime @db.Date
}

model emailAccounts {
  id                  String                          @id @default(auto()) @map("_id") @db.ObjectId
  accessToken         String?
  adsPower            EmailAccountsAdsPower
  /// Could not determine type: the field only had null or empty values in the sample set.
  appPassword         Json?
  connectionType      String?
  emailGroupId        String?                         @db.ObjectId
  emailReporting      EmailAccountsEmailReporting?
  engagementAccount   EmailAccountsEngagementAccount?
  esp                 String?
  espCamelCase        String
  hostId              String?                         @db.ObjectId
  inboxEngagement     EmailAccountsInboxEngagement?
  inboxPlacement      EmailAccountsInboxPlacement?
  lastUpdated         DateTime?                       @db.Date
  lastUpdated2fa      DateTime?                       @db.Date
  lastUpdatedPassword DateTime?                       @db.Date
  placementAccount    EmailAccountsPlacementAccount?
  refreshToken        String?
  relayAccount        EmailAccountsRelayAccount?
  senderName          String?
  server              String
  status              String?
  testResults         EmailAccountsTestResults?
  timeAdded           DateTime?                       @db.Date
  /// Could not determine type: the field only had null or empty values in the sample set.
  timeCreated         Json?
  username            String
  vpsDetails          EmailAccountsVpsDetails?
  webMail             EmailAccountsWebMail
}

model emailValidator {
  id              String                         @id @default(auto()) @map("_id") @db.ObjectId
  download        EmailValidatorDownload?
  hostId          String                         @db.ObjectId
  hostName        String
  lastUpdated     DateTime?                      @default(now())
  millionverifier EmailValidatorMillionverifier?
  status          String?
  upload          EmailValidatorUpload
}

model attribute_uploads {
  id              String                    @id @default(auto()) @map("_id") @db.ObjectId
  user_id         String                    @db.ObjectId
  csv_link        String
  date_uploaded   DateTime?                 @default(now())
  host_id         String                    @db.ObjectId
  host_name       String
  host_crypt      String?
  import_name     String
  last_updated    DateTime?                 @default(now())
  status          String?
  update_existing Boolean
  column_mappings Json?
  metadata        AttributeUploadsMetadata?
}

model hosts {
  id                 String                   @id @default(auto()) @map("_id") @db.ObjectId
  host               String
  hostCrypt          String
  userSettings       HostsUserSettings?
  lookerStudio       HostsLookerStudio?
  notifications      HostsNotifications?
  engagementSettings HostsEngagementSettings?
  ownerId            String?                  @db.ObjectId
  ownerName          String?
}

model smartleadEmailAccounts {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  username     String
  esp          String
  espCamelCase String
  hostId       String     @db.ObjectId
  hostName     String
  lastUpdated  DateTime   @db.Date
  server       String
  smartlead    SmartLead?
}

model seedBatches {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  dateAdded DateTime            @db.Date
  generate  SeedBatchesGenerate
  hostId    String              @db.ObjectId
  name      String
  results   SeedBatchesResults?
  status    String
  token     String
}

model senderAddresses {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  dateAdded     DateTime  @default(now())
  dateEmailSent DateTime? @db.Date
  error         String?
  hostId        String    @db.ObjectId
  status        String
  textRecord    String?
  emailToken    String?
  email         String    @unique
  verified      Boolean
  archived      Boolean
  verifiedVia   String?
  dateVerified  DateTime? @db.Date
}

model senderDomains {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  dateAdded    DateTime  @default(now())
  hostId       String    @db.ObjectId
  status       String
  txtRecord    String?
  domain       String    @unique
  verified     Boolean
  dateVerified DateTime? @db.Date
  verifiedVia  String?
}

model userSettings {
  id                      String                             @id @default(auto()) @map("_id") @db.ObjectId
  appLogin                UserSettingsAppLogin
  approval                UserSettingsApproval
  created                 Json?
  embedUrl                String?
  hosts                   String[]                           @db.ObjectId
  /// Multiple data types found: String: 63.6%, DateTime (Date): 36.4% out of 11 sampled entries
  lastUpdated             Json?
  lookerStudio            UserSettingsLookerStudio?
  plan                    UserSettingsPlan?
  resetPassword           UserSettingsResetPassword
  seeds                   UserSettingsSeeds?
  senders                 UserSettingsSenders?
  stripe                  UserSettingsStripe?
  trackingMarketing       UserSettingsTrackingMarketing?
  verification            UserSettingsVerification
  planPermissionsAssigned UserSettingsPlanPermissions
  planPermissionsUsed     UserSettingsPlanPermissions
  planPermissionFeatures  UserSettingsPlanPermissionFeatures
  webhook                 UserSettingsWebhook?
  ownerHostId             String                             @db.ObjectId
}

model webMail {
  id              String                  @id @default(auto()) @map("_id") @db.ObjectId
  bigquery        WebMailBigquery
  email           WebMailEmail?
  host            WebMailHost
  hostName        String
  inboxEngagement WebMailInboxEngagement?
  summary         WebMailSummary
}

model sender_accounts {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String                 @db.ObjectId
  host_id        String                 @db.ObjectId
  host_name      String
  host_crypt     String?
  sender         String
  sender_label   String?
  email_server   String?
  email_reseller String?
  platform       String
  type           String
  metadata       SenderAccountsMetadata
}

model events {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  event_timestamp DateTime             @db.Date
  event_type      String
  platform        String
  content         EventContent?
  host_id         String?              @db.ObjectId
  host_name       String?
  host_crypt      String?
  lead_status     EventLeadStatus?
  metadata        EventMetadata?
  recipient       EventRecipient?
  sender          EventSender?
  update_history  EventUpdateHistory[]
  user_id         String               @db.ObjectId
}

model config {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value Json?
}
